ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pos
APP_DATABASE_URL=postgresql://pos_app:pos_app@localhost:5433/pos
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=
# Set to production in real deployments (enforces JWT_SECRET requirements)
NODE_ENV=development
# Email digest + e-receipts: dry-run logged until both are set
SMTP_URL=
MAIL_FROM=
# Error tracking (Sentry DSN) - optional
SENTRY_DSN=
# Platform operator console key - enables /api/platform/* when set
PLATFORM_ADMIN_KEY=
# Card-present terminal capture + tenant billing (stubs until configured)
STRIPE_API_KEY=
STRIPE_BILLING_KEY=
# E-commerce channel sync (stub until configured)
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
